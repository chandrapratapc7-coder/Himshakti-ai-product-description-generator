# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/himshakti

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Google OAuth (create credentials at console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# App URLs
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# AI Provider (Week 7) — choose one: openai | gemini
AI_PROVIDER=gemini
AI_MODE=live
# fill in whichever provider you set above; the other can stay blank
OPENAI_API_KEY=
GEMINI_API_KEY=your_actual_gemini_key_here
